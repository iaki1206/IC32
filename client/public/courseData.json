    "foundationalRequirements": {
      "title": "Seven Foundational Requirements (FR)",
      "requirements": [
        {
          "id": "FR1",
          "acronym": "IAC",
          "name": "Identification and Authentication Control",
          "description": "Control access to selected devices, information or both",
          "relatedTo": [
            "Access Control",
            "User Management"
          ]
        },
        {
          "id": "FR2",
          "acronym": "UC",
          "name": "Use Control",
          "description": "Control use of selected devices, information or both. Protect against unauthorized operation.",
          "relatedTo": [
            "Authorization",
            "Permissions"
          ]
        },
        {
          "id": "FR3",
          "acronym": "SI",
          "name": "System Integrity",
          "description": "Ensure the integrity of data on selected communication channels. Protect against unauthorized changes.",
          "relatedTo": [
            "Data Integrity",
            "Checksums"
          ]
        },
        {
          "id": "FR4",
          "acronym": "DC",
          "name": "Data Confidentiality",
          "description": "Ensure the confidentiality of data on selected communication channels. Protect against eavesdropping.",
          "relatedTo": [
            "Encryption",
            "Privacy"
          ]
        },
        {
          "id": "FR5",
          "acronym": "RDF",
          "name": "Restrict Data Flow",
          "description": "Restrict the flow of data on communication channels. Protect against publication to unauthorized sources.",
          "relatedTo": [
            "Firewalls",
            "Network Segmentation"
          ]
        },
        {
          "id": "FR6",
          "acronym": "TRE",
          "name": "Timely Response to Events",
          "description": "Respond to security violations. Notify authorities. Report forensic evidence. Take corrective action.",
          "relatedTo": [
            "Incident Response",
            "Logging"
          ]
        },
        {
          "id": "FR7",
          "acronym": "RA",
          "name": "Resource Availability",
          "description": "Ensure the availability of all network resources. Protect against denial-of-service attacks.",
          "relatedTo": [
            "Availability",
            "DoS Protection"
          ]
        }
      ]
    }
  },
